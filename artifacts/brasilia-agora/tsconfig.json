{
  "extends": "../../tsconfig.base.json",
  /* `vite.config.ts` entra no typecheck: ele deixou de ser configuração e passou
     a carregar a cadeia de middlewares que decide status HTTP, redirect e
     indexabilidade. Fora daqui, um `Promise<Outcome>` sem `return` no fim
     compilava e ia para produção — foi o que aconteceu ao escrever o P0 de
     indexação. Os `*.test.ts` seguem excluídos (rodam por `tsx --test`). */
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    },
    {
      "path": "../../lib/social-template"
    }
  ]
}
