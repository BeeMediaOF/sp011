# ── Painel Central de Notícias — variáveis de ambiente (container central-api) ──
# Copie para .env.central na raiz (o docker-compose.yml lê este arquivo).
# NUNCA reutilize os segredos do blog: o central tem banco e chaves PRÓPRIOS.

# Connection string do Postgres do PAINEL CENTRAL (projeto Supabase separado,
# Session Pooler IPv4). Sem fallback: o central se recusa a subir sem ela.
CENTRAL_DATABASE_URL=postgresql://postgres.SEU_REF_CENTRAL:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Segredo dos tokens de sessão do painel central (64 bytes hex aleatórios).
# DIFERENTE do SESSION_SECRET do blog. Obrigatório em produção.
SESSION_SECRET=

# Chave da criptografia at-rest dos segredos (chaves de IA, segredos dos blogs).
# DIFERENTE da do blog. NÃO TROQUE depois de configurado (perde os segredos gravados).
SETTINGS_ENCRYPTION_KEY=

PORT=8090
NODE_ENV=production

# Primeiro admin do painel (semeado no primeiro boot; sem senha → gera aleatória no log)
CENTRAL_ADMIN_EMAIL=
CENTRAL_ADMIN_PASSWORD=

# Chave Gemini via env (opcional — o painel também aceita chaves pela interface)
GEMINI_API_KEY=

# CORS do painel (opcional; vazio = qualquer origem, auth é Bearer sem cookies)
CENTRAL_ALLOWED_ORIGINS=
