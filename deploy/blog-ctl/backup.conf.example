# backup.conf.example — configuracao do backup do pg-blogs (PRD-09).
# COPIE para /opt/blog-ctl/backup.conf e preencha os valores da sua VPS.
# NUNCA versione o .conf preenchido nem a passphrase (.pass) — o .gitignore
# deste diretorio ja protege ambos. Este .example NAO contem segredos reais.

# Onde roda o docker compose (raiz do repo na VPS).
REPO_DIR=/opt/sp011

# Raiz local dos dumps — FORA da arvore do git (nunca dentro de /opt/sp011).
LOCAL_BACKUP_DIR=/opt/backups

# Arquivo com a chave de cifra GPG (chmod 600, dono root, fora do repo).
# Guarde a MESMA chave tambem OFFLINE (gerenciador de senhas do operador):
# sem ela os backups cifrados sao irrecuperaveis.
PASSPHRASE_FILE=/opt/blog-ctl/backup.pass

# Remoto rclone (nome definido em `rclone config`) e pasta/bucket de destino.
RCLONE_REMOTE=offsite
RCLONE_PATH=sp011-backups

# Retencao (dias) local e offsite.
RETAIN_LOCAL_DAYS=7
RETAIN_REMOTE_DAYS=30
