# .env de uma instância de blog replicado — copie para /opt/blogs/<id>/.env
# e preencha. Este arquivo serve tanto à interpolação do compose.yml
# (BLOG_ID/COMPOSE_PROJECT_NAME/BLOG_IMAGE_TAG) quanto ao env_file da api.
#
# NÃO adicione aqui: OLLAMA_BASE_URL, GEMINI_API_KEY, PERPLEXITY_API_KEY —
# o blog roda em modo central-push puro (coleta/reescrita ficam no painel
# central). O banco é configurado pelo assistente em /admin/setup (wizard),
# por isso SUPABASE_DATABASE_URL fica comentado.

# ── Identidade da instância ──────────────────────────────────────────────────
# Slug: ^[a-z][a-z0-9-]{2,30}$ — vira alias na rede compartilhada (<id>-api).
# RESERVADOS (nunca use): "sp011" e "central" — colidiriam com os aliases do
# blog original e do painel na visão do Caddy.
BLOG_ID=cliente-a
# Sempre "blog-" + BLOG_ID (namespace de containers/volumes do projeto).
COMPOSE_PROJECT_NAME=blog-cliente-a
# Versão das imagens pré-buildadas (blog-api:<tag> / blog-web:<tag>).
BLOG_IMAGE_TAG=v1

# ── URLs públicas ────────────────────────────────────────────────────────────
APP_URL=https://cliente-a.seudominio.com.br
SITE_URL=https://cliente-a.seudominio.com.br
ALLOWED_ORIGINS=https://cliente-a.seudominio.com.br

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# ── Segredos próprios (gere com: openssl rand -hex 32) ───────────────────────
# IMUTÁVEIS por instância: trocar depois quebra os segredos salvos no banco
# e o arquivo de conexão db-config.enc.
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=

# ── Painel central ───────────────────────────────────────────────────────────
# Segredo de integração gerado ao cadastrar o blog no painel central
# (Blogs → Novo — exibido UMA única vez). O endpoint /api/ingest usa este
# valor quando o campo não foi preenchido no admin do blog.
CENTRAL_INGEST_SECRET=

# ── Web Push (opcional; gere um par NOVO por blog: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Banco de dados ───────────────────────────────────────────────────────────
# Deixe COMENTADO: sem esta variável a api sobe em modo instalação e o banco
# é configurado (validado + criptografado) pelo wizard em /admin/setup.
# Connection string do pg-blogs: postgresql://<id>_user:<senha>@pg-blogs:5432/<id>
# SUPABASE_DATABASE_URL=

# ── Ajustes de recursos (habilitados na Fase 1; hoje sem efeito) ─────────────
# PG_POOL_MAX=3
# DISABLE_LOCAL_PIPELINE=1
